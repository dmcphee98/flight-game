# This file documents the environment variables required for production.
# They must be set as repository secrets in GitHub Actions.
# See: Settings > Secrets and variables > Actions > Repository secrets

# For local development, a .env.local file is not required.
# Sensible defaults are used automatically.

# Lambda Function URL
# Wakes the EC2 game server and polls its status.
# Get this from the CDK stack output after running cdk deploy.
VITE_GAME_SERVER_WAKE_URL=https://xxxx.lambda-url.ap-southeast-2.on.aws/

# WebSocket URL for the game server.
# Defaults to ws://localhost:8080/ws in local development.
VITE_WS_URL=wss://<server-subdomain>.<domain>/ws